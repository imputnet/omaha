#!/bin/sh
set -eu

REV=7ff956173add630906515187ce16a956f0d2074e
FILES="
components/client_update_protocol/cup_unittest.cc
components/update_client/protocol_parser_json_unittest.cc
components/crx_file/crx_verifier_unittest.cc
components/crx_file/id_util_unittest.cc
components/test/data/crx_file/unsigned.crx3
components/test/data/crx_file/valid.crx2
components/test/data/crx_file/valid_no_publisher.crx3
components/test/data/crx_file/valid_publisher.crx3
components/test/data/crx_file/valid_test_publisher.crx3
"

root=$(cd "$(dirname "$0")/.." && pwd)
dest="$root/testdata/chromium/$REV"

fetch() {
    curl -fsSL --retry 5 --retry-all-errors -o "$2.b64" \
        "https://chromium.googlesource.com/chromium/src/+/$REV/$1?format=TEXT"
    base64 -d < "$2.b64" > "$2.tmp"
    rm "$2.b64"
    mv "$2.tmp" "$2"
}

for file in $FILES; do
    mkdir -p "$dest/$(dirname "$file")"
    fetch "$file" "$dest/$file"
done
fetch LICENSE "$dest/LICENSE"

echo "fetched Chromium $REV test data into $dest"
